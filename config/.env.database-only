# Database-Only Mode Configuration
# This configuration disables message broker publishing and only persists data to database

# Disable message broker publishing
DISABLE_MESSAGE_BROKER=true
MESSAGE_BROKER_ENABLED=false

# Database configuration (keep normal settings)
DATABASE_URL=postgresql://username:password@localhost:5432/trading_data
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_data
POSTGRES_USER=username
POSTGRES_PASSWORD=password

# Redis configuration (keep for caching)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Exchange configuration (keep normal settings)
KRAKEN_WS_TOKEN=your_token_here

# Logging
LOG_LEVEL=info

# Performance settings
CPU_CORES=0,1,2,3
THREAD_PRIORITY=high

# Message Broker (disabled but kept for compatibility)
MESSAGE_BROKER_ADDRESS=localhost
MESSAGE_BROKER_PORT=8080
