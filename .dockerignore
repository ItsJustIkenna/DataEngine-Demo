# Enterprise DataEngine Docker Ignore
# Designed for workspace build context containing all dependencies
# Optimized for: DataEngine/, databaseschema/, redisutils/, LoggingEngine/, MessageBrokerEngine/

# ============= EXCLUDE PATTERNS =============

# Version control (never needed in containers)
**/.git/
**/.gitignore
**/.github/

# Development environment files
**/.DS_Store
**/.env*
**/.vscode/
**/.vs/
**/.idea/
**/.project
**/.settings/
**/.toolstarget

# Build artifacts and caches (rebuild in container)
**/target/
**/node_modules/
**/.cargo/
**/dist/
**/build/

# Documentation (not needed for runtime)
**/README.md
**/CHANGELOG.md
**/LICENSE*
**/docs/
**/*.md
# Exception: Keep essential Docker docs
!**/DOCKER.md

# Benchmark infrastructure (not needed for production builds)
**/benches/

# Examples and demos (not needed for production)
**/examples/
**/demo*/
**/sample*/

# DevOps and deployment (not needed in container)
**/k8s/
**/helm/
**/*helm*/
**/terraform/
**/ansible/
**/docker-compose*.yml
**/compose*.yml
**/Dockerfile*
**/.dockerignore

# Temporary and cache files
**/*.tmp
**/*.temp
**/*.cache
**/*.swp
**/*.swo
**/.*~
**/*.bak
**/*.backup

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# IDE and editor artifacts
**/*.suo
**/*.user
**/*.userosscache
**/*.sln.docstates

# ============= EXPLICIT INCLUDES (Override excludes) =============

# Critical business logic files that might be caught by broad patterns
!**/backtest_result.rs
!**/backtest_result_ops.rs

# Essential configuration files
!**/Cargo.toml
!**/Cargo.lock

# Production configuration (if any)
!**/prod.conf
!**/production.conf