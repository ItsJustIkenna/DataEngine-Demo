# .dockerignore for TradingPlatform workspace
# This file is used when building Docker images from the workspace root
# Context: docker build -f DataEngine/Dockerfile .

# Git files (all repos)
**/.git/
**/.gitignore
**/.github/
**/.gitattributes

# Build artifacts (exclude to reduce context size, but Docker will rebuild anyway)
**/target/

# IDE and editor files
**/.vscode/
**/.idea/
**/*.swp
**/*.swo
**/*~
**/.DS_Store

# Environment and secrets
**/.env
**/.env.*
**/appsettings.json

# Helm values with credentials
**/values-dev.yaml
**/values-qa.yaml
**/values-prod.yaml
**/values-local.yaml
**/values-secrets.yaml
**/k8s/helm/values-*.yaml

# Secrets and credentials
**/secrets.yaml
**/credentials.yaml
**/*secrets*
**/*credentials*

# Documentation (not needed in image)
**/*.md
**/LICENSE
**/README.md

# Docker files themselves
**/Dockerfile
**/.dockerignore
**/docker-compose.yml
**/compose.yaml

# CI/CD files
**/.github/
DataEngine/k8s/

# Development tools
**/.cargo/
**/Makefile

# Exclude engines not needed for DataEngine build
BacktestingEngine/
SimulationEngine/
SignalEngine/
